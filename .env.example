# Example environment variables (used if you run without Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_search

# Rate limiter
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=60

# API keys -> org_id mapping
# Example: {"demo-org-1":1,"demo-org-2":2}
API_KEYS_JSON=

# org_id -> allowed columns mapping
# Example: {"1":["id","name","email"],"2":["id","name","phone"]}
ORG_ALLOWED_COLUMNS_JSON=
